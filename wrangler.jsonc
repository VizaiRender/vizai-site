{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Entrada própria que envolve o .open-next/worker.js com o cache de imagem.
  // Ver o comentário no topo do arquivo antes de voltar pro worker gerado.
  "main": "cloudflare-worker.mjs",
  "name": "vizai-site",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "vizai-site"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Id da versão publicada. Entra na chave do cache de imagem do
  // cloudflare-worker.mjs, pra que nenhuma imagem guardada sobreviva a um deploy.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "vizai-site-cache"
    }
  ],
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "paginas-prontas"
  },
  "observability": {
    "enabled": true
  }
}
